# =============================================================================
# Telegram Bot — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# On Lovable Cloud, runtime secrets are stored via the Secrets manager, not in
# a committed .env. This file documents what the server code expects.
# =============================================================================


# -----------------------------------------------------------------------------
# Lovable Cloud / Supabase (backend database + auth)
# -----------------------------------------------------------------------------
# Public-facing (safe to expose in the browser bundle). VITE_* variants are
# read by client code; the un-prefixed variants are read by server code.

VITE_SUPABASE_URL="https://YOUR-PROJECT.lovable.cloud"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXX"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

SUPABASE_URL="https://YOUR-PROJECT.lovable.cloud"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXX"
SUPABASE_PROJECT_ID="your-project-ref"

# SERVER-ONLY. Bypasses RLS. Used by the bot to read/write on behalf of users.
# Never expose to the browser. On Lovable Cloud this is injected automatically.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXXXX"


# -----------------------------------------------------------------------------
# Telegram Bot API (via Lovable connector gateway)
# -----------------------------------------------------------------------------
# TELEGRAM_API_KEY is the Lovable *connection key* for the Telegram connector
# — NOT the raw bot token from @BotFather. Obtain by connecting the Telegram
# connector in Lovable; the value is injected as an env var automatically.
TELEGRAM_API_KEY="lovable_telegram_connection_key_XXXXXXXX"

# Lovable connector-gateway auth key. Injected automatically on Lovable Cloud.
LOVABLE_API_KEY="lovable_api_key_XXXXXXXXXXXXXXXXXXXXXX"


# -----------------------------------------------------------------------------
# Telegram webhook secret (derived, not user-supplied)
# -----------------------------------------------------------------------------
# The webhook endpoint verifies the `X-Telegram-Bot-Api-Secret-Token` header
# against a value derived from TELEGRAM_API_KEY:
#
#   secret = base64url( sha256( "telegram-webhook:" + TELEGRAM_API_KEY ) )
#
# You do NOT set this manually. It's computed at runtime in
# src/lib/bot/webhook-secret.ts and passed to Telegram's setWebhook call.
# The same derivation also produces the `x-telegram-bot-secret` header used
# by is_telegram_bot_request() in the database.


# -----------------------------------------------------------------------------
# Public bot URLs (used to register the webhook with Telegram)
# -----------------------------------------------------------------------------
# Use the STABLE project host, not the id-preview URL (which redirects
# through auth and breaks Telegram delivery).
#
#   Preview: https://project--<PROJECT_ID>-dev.lovable.app/api/public/telegram/webhook
#   Prod:    https://project--<PROJECT_ID>.lovable.app/api/public/telegram/webhook
#
# Register with:
#   curl https://connector-gateway.lovable.dev/telegram/setWebhook \
#     -H "Authorization: Bearer $LOVABLE_API_KEY" \
#     -H "X-Connection-Api-Key: $TELEGRAM_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"<WEBHOOK_URL>","secret_token":"<DERIVED_SECRET>","allowed_updates":["message","edited_message","channel_post","chat_join_request"]}'


# -----------------------------------------------------------------------------
# Cron endpoints (called by pg_cron on a schedule)
# -----------------------------------------------------------------------------
# These are public POST endpoints — no secret required, they're idempotent:
#   /api/public/hooks/drip         — publishes queued posts on the drip schedule
#   /api/public/hooks/autodelete   — deletes messages whose TTL has expired
#   /api/public/hooks/auto-backup  — periodic DB backup snapshot
